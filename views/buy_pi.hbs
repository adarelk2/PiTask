<div class="container py-4">
  <h2 class="mb-4" style="color:goldenrod;">🪙 Buy Pi Coins</h2>

  <!-- Balance summary -->
  <div class="alert alert-secondary">
    Your current balance: <strong>{{user.balance}} π</strong>
  </div>

  <!-- Purchase UI -->
  <div class="card shadow-sm p-4">
    <div class="mb-3">
      <label for="amount" class="form-label">Amount of Pi to Buy</label>
      <input type="number" class="form-control" id="amount" min="1" step="0.01" required>
    </div>

    <div class="mb-3">
      <label for="estimated_price" class="form-label">Estimated Price (USD)</label>
      <input type="text" class="form-control" id="estimated_price" readonly value="{{estimatedPrice}}">
    </div>

    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" id="terms" required>
      <label class="form-check-label" for="terms">
        I agree to the <a href="/terms" target="_blank">terms and conditions</a>
      </label>
    </div>

    <button type="button" class="btn btn-purple w-100" id="createPaymentBTN">💸 Buy Now</button>
  </div>

  <div class="mt-4 text-muted">
    Note: Conversion rate is updated periodically. Final value will be confirmed before processing the transaction.
  </div>
</div>

<!-- Pi SDK -->
<script src="https://sdk.minepi.com/pi-sdk.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  if (!window.Pi) {
    alert("Pi SDK not available. Please open this app in Pi Browser.");
    return;
  }

  // Init SDK (Production mode – no sandbox)
  window.Pi.init({ version: "2.0" });

  document.getElementById('createPaymentBTN').addEventListener('click', async () => {
    const amount = document.getElementById('amount').value;
    const agreed = document.getElementById('terms').checked;

    if (!amount || parseFloat(amount) <= 0) {
      alert("Please enter a valid amount.");
      return;
    }

    if (!agreed) {
      alert("You must agree to the terms and conditions.");
      return;
    }

    try {
      // Authenticate the user with 'payments' scope
      const authResult = await window.Pi.authenticate(['payments']);
      console.log("✅ Authenticated:", authResult);

      const paymentData = {
        amount: parseFloat(amount),
        memo: "Buy Pi in production",
        metadata: {
          type: "buy_pi",
          userId: "{{user.id}}"
        },
        recipient: "adarelk1" // ← your Pi username from the Developer Portal
      };

      await window.Pi.createPayment(paymentData, {
        onReadyForServerApproval: async function (paymentId) {
          console.log("📨 Production Payment ID:", paymentId);

          try {
            const res = await fetch("/auth/approve-production", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ paymentId })
            });

            const result = await res.json();

            if (result.status === "done") {
              console.log("✅ Server approved and completed payment.");
              // The SDK will now trigger onReadyForServerCompletion automatically
            } else {
              console.warn("❌ Server rejected payment.");
              alert("Server rejected payment.");
            }
          } catch (e) {
            console.error("❌ Error contacting server:", e);
            alert("Error contacting server. See console.");
          }
        },
        onReadyForServerCompletion: function (paymentId, txid) {
          console.log("✅ Payment completed!", paymentId, txid);
          alert("Payment completed successfully!");
        },
        onCancel: function () {
          alert("Payment was cancelled.");
        },
        onError: function (error) {
          console.error("Pi Payment Error:", error);
          alert("Payment failed. See console.");
        }
      });

    } catch (err) {
      console.error("❌ Unexpected Error:", err);
      alert("Authentication or payment failed. See console.");
    }
  });
});
</script>
