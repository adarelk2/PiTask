<div class="fade-in">
  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-soft">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-4">
              <i class="fas fa-coins text-warning fs-1"></i>
            </div>
            <div>
              <h2 class="mb-1 text-warning">{{__ "buy_pi"}}</h2>
              <p class="mb-0">Purchase Pi tokens to fund your tasks</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Current Balance -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-info border-0 shadow-soft">
        <div class="d-flex align-items-center">
          <i class="fas fa-wallet text-info fs-4 me-3"></i>
          <div>
            <h6 class="mb-0 text-info">{{__ "current_balance"}}</h6>
            <span class="fw-bold text-info fs-4">{{user.balance}} π</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Purchase Form -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card shadow-soft">
        <div class="card-header bg-warning bg-opacity-10">
          <h5 class="card-title mb-0 text-warning">
            <i class="fas fa-shopping-cart me-2"></i>Purchase Details
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="amount" class="form-label">
                <i class="fas fa-coins me-1"></i>{{__ "amount_to_buy"}}
              </label>
              <div class="input-group">
                <input type="number" class="form-control" id="amount" min="1" step="0.01" 
                       placeholder="Enter amount" required>
                <span class="input-group-text">π</span>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <label for="estimated_price" class="form-label">
                <i class="fas fa-dollar-sign me-1"></i>{{__ "estimated_price"}}
              </label>
              <div class="input-group">
                <input type="text" class="form-control" id="estimated_price" readonly value="{{estimatedPrice}}">
                <span class="input-group-text">USD</span>
              </div>
            </div>

            <div class="col-12 mb-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="terms" required>
                <label class="form-check-label text-white" for="terms">
                  <i class="fas fa-check-circle me-1"></i>
                  {{__ "agree_terms"}} <a href="/terms" class="menu-link text-primary" target="_blank">{{__ "terms_link"}}</a>
                </label>
              </div>
            </div>

            <div class="col-12">
              <button type="button" class="btn btn-warning btn-lg w-100" id="createPaymentBTN">
                <i class="fas fa-credit-card me-2"></i>{{__ "buy_now"}}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment Info -->
    <div class="col-lg-4">
      <div class="card shadow-soft">
        <div class="card-header bg-success bg-opacity-10">
          <h5 class="card-title mb-0 text-success">
            <i class="fas fa-info-circle me-2"></i>Payment Info
          </h5>
        </div>
        <div class="card-body">
          <div class="text-center mb-4">
            <div class="bg-light rounded-circle p-4 mx-auto mb-3" style="width: 80px; height: 80px;">
              <i class="fas fa-shield-alt text-success fs-2"></i>
            </div>
            <h6 class="text-success">Secure Payment</h6>
            <p class="small">Powered by Pi Network</p>
          </div>

          <div class="mb-3">
            <h6 class="text-primary mb-2">
              <i class="fas fa-check-circle me-1"></i>Benefits
            </h6>
            <ul class="list-unstyled small text-muted">
              <li class="mb-1"><i class="fas fa-arrow-right text-primary me-2"></i>Instant processing</li>
              <li class="mb-1"><i class="fas fa-arrow-right text-primary me-2"></i>Low fees</li>
              <li class="mb-1"><i class="fas fa-arrow-right text-primary me-2"></i>Secure transactions</li>
              <li class="mb-1"><i class="fas fa-arrow-right text-primary me-2"></i>24/7 support</li>
            </ul>
          </div>

          <div class="alert border-0">
            <small class="text-warning">
              <i class="fas fa-info-circle me-1"></i>
              {{__ "conversion_note"}}
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Debug Log -->
  <div id="debug-log" class="mt-4 p-3 bg-light border rounded d-none" 
       style="font-family: monospace; white-space: pre-wrap; font-size: 0.85rem; max-height: 300px; overflow-y: auto;">
    <strong>{{__ "debug_log"}}:</strong>
  </div>
</div>

<!-- Pi SDK -->
<script src="https://sdk.minepi.com/pi-sdk.js"></script>

<script>

  const logBox = document.getElementById("debug-log");

  function logDebug(message, obj = null) {
    const time = new Date().toLocaleTimeString();
    logBox.innerText += `\n[${time}] ${message}`;
    if (obj) {
      logBox.innerText += `\n${JSON.stringify(obj, null, 2)}\n`;
    }
  }

  if (!window.Pi) {
    logDebug("❌ Pi SDK not available. Please open this app in Pi Browser.");
    infoAlert("Pi SDK not available. Please open this app in Pi Browser.", "Pi Browser Required");
  }

  window.Pi.init({ version: "2.0" });

  document.getElementById('createPaymentBTN').addEventListener('click', async () => {
    const amount = document.getElementById('amount').value;
    const agreed = document.getElementById('terms').checked;

    if (!amount || parseFloat(amount) <= 0) {
      validationAlert("Please enter a valid amount.", "Invalid Amount");
      return;
    }

    if (!agreed) {
      validationAlert("You must agree to the terms and conditions.", "Terms Required");
      return;
    }

    try {
      const authResult = await window.Pi.authenticate(['payments']);
      logDebug("✅ Authenticated", authResult);

      const token = localStorage.getItem("token");
      const userId = "{{user.id}}";

      const paymentData = {
        amount: parseFloat(amount),
        memo: "Buy Pi in production",
        metadata: {
          type: "buy_pi",
          userId: userId
        },
        recipient: "adarelk1.trs-f65b74c907519592"
      };

      logDebug("📦 Payment data", paymentData);

      await window.Pi.createPayment(paymentData, {
        // 🔄 טיפול בתשלום תקוע
        onIncompletePaymentFound: async function (payment) {
          logDebug("⚠️ Incomplete payment found", payment);

          try {
            const res = await fetch("/auth/approve-production", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ paymentId: payment.identifier, token, lang }),
              credentials: "include"
            });

            const result = await res.json();
            logDebug("🔁 Re-approval result", result);

            if (result.status === "approved") {
              logDebug("✅ Re-approved pending payment.");
            } else {
              paymentErrorAlert("Pending payment could not be approved again.");
            }
          } catch (e) {
            logDebug("❌ Error handling pending payment", e.message || e);
            paymentErrorAlert("Error handling previous payment.");
          }
        },

        // ✅ תשלום חדש
        onReadyForServerApproval: async function (paymentId) {
          logDebug("📨 Payment ID received", { paymentId });
          try {
            const res = await fetch("/auth/approve-production", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ paymentId, token , lang}),
              credentials: "include"
            });

            const result = await res.json();
            logDebug("🔁 Server approval response", result);

            if (result.status === "approved") {
              logDebug("✅ Payment approved by server.");
            } else {
              paymentErrorAlert("Server rejected payment.");
            }
          } catch (e) {
            logDebug("❌ Approval error", e.message || e);
            paymentErrorAlert("Approval error.");
          }
        },

        onReadyForServerCompletion: async function (paymentId, txid) {
          logDebug("⏳ Payment ready for completion", { paymentId, txid, lang});
          try {
            const res = await fetch("/auth/complete-production", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ paymentId, txid, token, lang }),
              credentials: "include"
            });

            const result = await res.json();
            logDebug("✅ Completion response", result);

            if (result.status === "done") {
              paymentSuccessAlert("Payment completed successfully!");
            } else {
              warningAlert("Payment not completed. See debug log.", "Payment Incomplete");
            }
          } catch (e) {
            logDebug("❌ Completion error", e.message || e);
            paymentErrorAlert("Payment completion failed.");
          }
        },

        onCancel: function () {
          logDebug("⚠️ Payment cancelled by user.");
          warningAlert("Payment cancelled by user.", "Payment Cancelled");
        },

        onError: function (error) {
          logDebug("❌ Pi Payment error", error?.message || JSON.stringify(error) || "Unknown error");
          paymentErrorAlert("Payment failed. See debug log.");
        }
      });

    } catch (err) {
      logDebug("❌ Unexpected error", err.message || err);
      paymentErrorAlert("Something went wrong. Please try again.");
    }
  });
</script>
