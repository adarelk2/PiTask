<!-- Pi SDK -->
<script src="https://sdk.minepi.com/pi-sdk.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const logBox = document.getElementById("debug-log");

  function logDebug(message, obj = null) {
    const time = new Date().toLocaleTimeString();
    logBox.innerText += `\n[${time}] ${message}`;
    if (obj) {
      logBox.innerText += `\n${JSON.stringify(obj, null, 2)}\n`;
    }
  }

  if (!window.Pi) {
    logDebug("❌ Pi SDK not available. Please open this app in Pi Browser.");
    alert("Pi SDK not available. Open in Pi Browser.");
    return;
  }

  window.Pi.init({ version: "2.0" });

  document.getElementById('createPaymentBTN').addEventListener('click', async () => {
    const amount = document.getElementById('amount').value;
    const agreed = document.getElementById('terms').checked;

    if (!amount || parseFloat(amount) <= 0) {
      alert("Please enter a valid amount.");
      return;
    }

    if (!agreed) {
      alert("You must agree to the terms and conditions.");
      return;
    }

    try {
      const authResult = await window.Pi.authenticate(['payments']);
      logDebug("✅ Authenticated", authResult);

      const paymentData = {
        amount: parseFloat(amount),
        memo: "Buy Pi in production",
        metadata: {
          type: "buy_pi",
          userId: "{{user.id}}"
        },
        recipient: "adarelk1"
      };

      await window.Pi.createPayment(paymentData, {
        onReadyForServerApproval: async function (paymentId) {
          logDebug("📨 Ready for server approval", { paymentId });

          try {
            const res = await fetch("/auth/approve-production", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ paymentId, amount: paymentData.amount }),
              credentials: "include"
            });

            const result = await res.json();
            logDebug("🔁 Server approval response", result);

            if (result.status === "approved") {
              logDebug("✅ Server approved. Waiting for transaction...");
            } else {
              alert("❌ Server rejected payment.");
            }
          } catch (e) {
            logDebug("❌ Approval error", e);
            alert("Server approval failed.");
          }
        },

        onReadyForServerCompletion: async function (paymentId, txid) {
          logDebug("⏳ Ready for completion", { paymentId, txid });

          try {
            if (!txid) {
              alert("❌ Missing txid. Cannot complete payment.");
              return;
            }

            const res = await fetch("/auth/complete-production", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ paymentId, txid }),
              credentials: "include"
            });

            const result = await res.json();
            logDebug("✅ Completion response", result);

            if (result.status === "done") {
              alert("✅ Payment completed!");
            } else {
              alert("⚠️ Completion failed. See log.");
            }
          } catch (e) {
            logDebug("❌ Completion error", e);
            alert("Error completing payment.");
          }
        },

        onCancel: function () {
          logDebug("⚠️ Payment cancelled by user.");
          alert("Payment cancelled.");
        },

        onError: function (error) {
          logDebug("❌ Pi Payment error", error);
          alert("Payment failed. Check log.");
        }
      });

    } catch (err) {
      logDebug("❌ Unexpected error", err);
      alert("Something went wrong.");
    }
  });
});
</script>
