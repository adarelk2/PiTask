<!DOCTYPE html>
<html lang="{{lang}}" dir="{{__ "dir"}}">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    
    <!-- Modern CSS Framework -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Custom Styles -->
    <link href="/styles.css" rel="stylesheet">
    
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/init.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RBXZJ5TMHT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RBXZJ5TMHT');
    </script>


    <script>
    url_params = getAllParams();
    if (!url_params.lang && lang) {
      const url = new URL(window.location.href);
      url.searchParams.set("lang", lang); // אפשר לשים עברית, או ערך אחר שתרצה
      window.location.href = url.toString();
    }
</script>
  </head>
  <body class="{{__ "dir"}} modern-body">
    {{> header title=headerTitle user=user }}
    
    <main class="main-content">
      <div class="container-fluid px-3 px-md-4 py-4">
        {{{body}}}
      </div>
    </main>
    
    {{> footer}}
  </body>
</html>