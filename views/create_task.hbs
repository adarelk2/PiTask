<h2 class="mb-4">{{__ "create_new_task"}}</h2>

<form method="POST" id="send_request">
  <div class="mb-3">
    <label for="title" class="form-label">{{__ "task_title"}}</label>
    <input type="text" name="title" id="title" class="form-control" required>
  </div>

  <div class="mb-3">
    <label for="description" class="form-label">{{__ "task_description"}}</label>
    <textarea name="description" id="description" class="form-control" rows="4" required></textarea>
  </div>

  <div class="mb-3">
    <label for="max_users" class="form-label">{{__ "max_users"}}</label>
    <input type="number" name="max_users" id="max_users" class="form-control" value="0" min="1" required>
  </div>

  <div class="mb-3">
    <label for="reward" class="form-label">{{__ "reward_per_user"}}</label>
    <input type="number" name="reward" id="reward" class="form-control" value="0" step="0.01" min="0.01" required>
  </div>

  <div class="mb-3">
    <label for="required_level" class="form-label">{{__ "required_user_level"}}</label>
    <select name="required_level" id="required_level" class="form-select" required>
      <option value="1">{{__ "level_1"}}</option>
      <option value="2" disabled>{{__ "level_2_disabled"}}</option>
    </select>
  </div>

  <div class="mb-3 d-none" id="proofDiv">
    <label for="proof_description" class="form-label">{{__ "proof_description"}}</label>
    <textarea name="proof_description" id="proof_description" class="form-control" rows="2"
              placeholder="{{__ 'proof_placeholder'}}"></textarea>
  </div>

  <div class="mb-3" id="url_div">
    <label for="url" class="form-label">{{__ "url_label"}}</label>
    <input type="text" name="url" id="url" class="form-control"
           placeholder="{{__ 'url_placeholder'}}">
  </div>

  <div class="mb-3">
    <div>{{__ "reward_total"}}: <span id="total_price">0</span> Pi</div>
    <div>{{__ "platform_fee"}} (<span id="platform_fee_percent">0</span>%): <span id="paymentFeeAmount">0</span> Pi</div>
    <div><strong>{{__ "total_pi_required"}}:</strong> <span id="total_pi_required">0</span> Pi</div>
  </div>

  <button type="submit" class="btn btn-purple" id="send_requestBTN">{{__ "publish_task"}}</button>
</form>

<div id="debug-log" class='d-none' style="margin-top:40px; font-family: monospace; background: #f9f9f9; border: 1px solid #ddd; padding: 1em; display: none;"></div>

<script>
  const PAYMENT_FEE = parseFloat("1.1"); // adjust as needed

  const rewardInput = document.getElementById('reward');
  const usersInput = document.getElementById('max_users');
  const required_level = document.getElementById('required_level');
  const proofDiv = document.getElementById('proofDiv');
  const urlDiv = document.getElementById('url_div');
  const title = document.getElementById('title');
  const description = document.getElementById('description');
  const proof_description = document.getElementById('proof_description');
  const url_input = document.getElementById('url');

  const totalOutput = document.getElementById('total_price');
  const paymentFeeAmount = document.getElementById('paymentFeeAmount');
  const platform_fee_percent = document.getElementById('platform_fee_percent');
  const total_pi_required = document.getElementById('total_pi_required');

  const feePercent = PAYMENT_FEE - 1;
  platform_fee_percent.textContent = (feePercent * 100).toFixed(1);

  const updateTotal = () => {
    const reward = parseFloat(rewardInput.value) || 0;
    const users = parseInt(usersInput.value) || 0;
    const baseTotal = reward * users;
    const feeAmount = baseTotal * feePercent;
    const fullTotal = baseTotal + feeAmount;

    totalOutput.textContent = baseTotal.toFixed(2);
    paymentFeeAmount.textContent = feeAmount.toFixed(2);
    total_pi_required.textContent = fullTotal.toFixed(2);
  };

  const updateRequireLevel = () => {
    if (required_level.value === "1") {
      proofDiv.classList.add('d-none');
      urlDiv.classList.remove('d-none');
      proof_description.removeAttribute("required");
      url_input.setAttribute("required", "true");
    } else {
      proofDiv.classList.remove('d-none');
      urlDiv.classList.add('d-none');
      url_input.removeAttribute("required");
      proof_description.setAttribute("required", "true");
    }
  };

  rewardInput.addEventListener('input', updateTotal);
  usersInput.addEventListener('input', updateTotal);
  required_level.addEventListener('change', updateRequireLevel);
  window.addEventListener('DOMContentLoaded', updateRequireLevel);

  document.getElementById("send_request").addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!e.target.checkValidity()) return;

    const token = localStorage.getItem("token");

    const payload = {
      method: "create_new_task",
      token,
      params: {
        reward: rewardInput.value,
        max_users: usersInput.value,
        required_level: required_level.value,
        title: title.value,
        description: description.value,
        proof_description: proof_description.value,
        url: url_input.value
      }
    };

    showPopUpConfirming(create_request, payload);
  });

  const create_request = async (_params) => {
    showLoading();
    try {
      const res = await fetch("/create_task", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify(_params)
      });

      const text = await res.text();
      let response;
      try {
        response = JSON.parse(text);
      } catch (jsonErr) {
        throw new Error("Server returned invalid JSON.");
      }

      Swal.close();

      if (response.flag) {
        successAlert(response.errors, reload);
      } else {
        failedAlert(response.errors);
      }

    } catch (err) {
      alert(`Something went wrong! - ${err.message || err}`);
    }
  };

  const reload = () => {
    let token = localStorage.getItem("token");
    window.location.href = `/create_task?token=${token}`;
  };
</script>