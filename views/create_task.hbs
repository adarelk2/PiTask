<!-- Debug Log Output -->
<div id="debug-log" style="margin-top:40px; font-family: monospace; background: #f9f9f9; border: 1px solid #ddd; padding: 1em; display: none;"></div>

<script>
  function logDebug(label, data) {
    const debug = document.getElementById('debug-log');
    debug.style.display = "block";
    const block = document.createElement("div");
    block.style.marginBottom = "1em";
    block.innerHTML = `<strong>${label}</strong><pre>${JSON.stringify(data, null, 2)}</pre>`;
    debug.appendChild(block);
  }

  const create_requiest = async (_params) => {
    showLoading();
    try {
      logDebug("🚀 Sending Payload", _params);

      const res = await fetch("/create_task", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify(_params)
      });

      logDebug("📥 Raw Response Object", {
        ok: res.ok,
        status: res.status,
        statusText: res.statusText,
        url: res.url
      });

      const text = await res.text();
      logDebug("📝 Raw Response Text", text);

      let response;
      try {
        response = JSON.parse(text);
        logDebug("✅ Parsed JSON", response);
      } catch (jsonErr) {
        throw new Error("Invalid JSON returned from server.");
      }

      Swal.close();

      if (response.flag) {
        successAlert(response.errors, reload);
      } else {
        failedAlert(response.errors);
      }
    } catch (err) {
      logDebug("❌ Caught Error", err);
      alert(`Something went wrong! - ${err.message || err}`);
    }
  };
</script>
