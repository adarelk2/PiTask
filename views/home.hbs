<div class="fade-in">
  <!-- Welcome Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-soft">
        <div class="card-body text-center py-4">
          <div class="d-flex align-items-center justify-content-center mb-3">
            <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
              <i class="fas fa-user-circle text-primary" style="font-size: 2.5rem;"></i>
            </div>
            <div class="text-start">
              <h2 class="mb-1 text-primary fw-bold">{{__ "dashboard"}}</h2>
              <p class="text-muted mb-0 fs-5">{{__ "welcome"}} <strong class="text-primary">{{user.username}}</strong></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- User Stats Section -->
  <div class="row mb-4">
    <div class="col-md-6 mb-3">
      <div class="card shadow-soft h-100">
        <div class="card-body text-center">
          <div class="bg-success bg-opacity-10 rounded-circle p-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
            <i class="fas fa-trophy text-success" style="font-size: 1.8rem;"></i>
          </div>
          <h5 class="card-title text-success fw-bold mb-2">{{__ "level"}}</h5>
          <h3 class="text-success mb-0 fw-bold">{{level}}</h3>
        </div>
      </div>
    </div>
    <div class="col-md-6 mb-3">
      <div class="card shadow-soft h-100">
        <div class="card-body text-center">
          <div class="bg-warning bg-opacity-10 rounded-circle p-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
            <i class="fas fa-chart-line text-warning" style="font-size: 1.8rem;"></i>
          </div>
          <h5 class="card-title text-warning fw-bold mb-2">{{__ "kd"}}</h5>
          <h3 class="text-warning mb-0 fw-bold">{{kd}}</h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Available Tasks Section -->
  <div class="row">
    <div class="col-12">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="mb-0 fw-bold">
          <i class="fas fa-tasks text-primary me-2"></i>
          {{__ "available_tasks"}}
        </h3>
        <span class="badge bg-primary fs-6 px-3 py-2">{{#if tasks.length}}{{tasks.length}}{{else}}0{{/if}} {{__ "tasks"}}</span>
      </div>
    </div>
  </div>

  {{#if tasks.length}}
    <div class="row">
      {{#each tasks}}
        <div class="col-lg-6 col-xl-4 mb-4">
          <div class="card task-card h-100 shadow-soft">
            <div class="card-body d-flex flex-column p-4">
              <div class="d-flex align-items-start justify-content-between mb-3">
                <h5 class="card-title mb-0 flex-grow-1 me-2 fw-bold text-primary">{{title}}</h5>
                <span class="badge bg-secondary px-2 py-1">{{__ "level"}} {{required_level}}</span>
              </div>
              
              <p class="card-text text-muted flex-grow-1 mb-3 lh-base">{{description}}</p>
              
              <div class="d-flex align-items-center justify-content-between mt-auto">
                <div class="d-flex align-items-center">
                  <i class="fas fa-coins text-warning me-2" style="font-size: 1.2rem;"></i>
                  <span class="fw-bold text-warning fs-5">{{reward}} π</span>
                </div>
                <button data-id="{{id}}" class="btn btn-primary btn-sm taskPull px-3 py-2">
                  <i class="fas fa-hand-paper me-1"></i>{{__ "take_task"}}
                </button>
              </div>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="row">
      <div class="col-12">
        <div class="card shadow-soft">
          <div class="card-body text-center py-5">
            <div class="bg-light rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
              <i class="fas fa-inbox text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-muted mb-3 fw-bold">{{__ "no_tasks"}}</h4>
            <p class="text-muted mb-4 fs-5">Check back later for new tasks to complete!</p>
            <button class="btn btn-outline-primary px-4 py-2" onclick="location.reload()">
              <i class="fas fa-refresh me-2"></i>Refresh
            </button>
          </div>
        </div>
      </div>
    </div>
  {{/if}}
</div>

<script>
  const btns = document.querySelectorAll(".taskPull");
  const token = localStorage.getItem("token");

  btns.forEach((btn)=>{
    btn.addEventListener("click", async(e)=>{
      let taskID = e.target.getAttribute("data-id");
      console.log(taskID);
      showLoading();

    try {
      let response;
      const res = await fetch("/home", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({params:{taskID}, token, lang, method:"claimTask"})
      });

      const text = await res.text();
      try {
        response = JSON.parse(text);
      } catch (jsonErr) {
        throw new Error("Server returned invalid JSON.");
      }

      Swal.close();

      if (response.flag) {
        btn.setAttribute("disabled", "true");
        successAlert(response.errors);
      } else {
        failedAlert(response.errors);
      }

    } catch (err) {
      failedAlert(`Something went wrong! - ${err.message || err}`, "Error");
    }

      })
  })
</script>