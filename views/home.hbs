  <h2>Dashboard</h2>
  <p>Hello {{user.username}}</p>

  <table class="table">
    <thead>
      <th>Level</th>
      <th>KD</th>
    </thead>
    <tbody>
      <tr><td>{{level}}</td><td>{{kd}}</td></tr>
    </tbody>
  </table>
  <hr>
  <h3>Available Tasks</h3>

  {{#if tasks.length}}
    <div class="row ">
      {{#each tasks}}
        <div class="col-md-6 mb-4">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{title}}</h5>
              <p class="card-text">{{description}}</p>
              <p class="card-text"><small>Required level: {{required_level}}</small></p>
              <p class="card-text"><strong>Reward:</strong> {{reward}} π</p>
              <a href="/tasks/{{id}}" class="btn btn-purple">Take Task</a>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p>No tasks available at the moment. Please check back later!</p>
  {{/if}}
</div>
