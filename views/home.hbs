<h2>{{__ "dashboard"}}</h2>
<p>{{__ "welcome"}} {{user.username}}</p>

<table class="table">
  <thead>
    <th>{{__ "level"}}</th>
    <th>{{__ "kd"}}</th>
  </thead>
  <tbody>
    <tr><td>{{level}}</td><td>{{kd}}</td></tr>
  </tbody>
</table>
<hr>
<h3>{{__ "available_tasks"}}</h3>

{{#if tasks.length}}
  <div class="row">
    {{#each tasks}}
      <div class="col-md-6 mb-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">{{title}}</h5>
            <p class="card-text">{{description}}</p>
            <p class="card-text"><small>{{__ "required_level"}}: {{required_level}}</small></p>
            <p class="card-text"><strong>{{__ "reward"}}:</strong> {{reward}} π</p>
            <button data-id="{{id}}" class="btn btn-purple taskPull">{{__ "take_task"}}</button>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <p>{{__ "no_tasks"}}</p>
{{/if}}
</div>

<script>
  const btns = document.querySelectorAll(".taskPull");
  console.log(btns);
  const token = localStorage.getItem("token");

  btns.forEach((btn)=>{
    btn.addEventListener("click", async(e)=>{
      let taskID = e.target.getAttribute("data-id");
      console.log(taskID);
      showLoading();

    try {
      let response;
      const res = await fetch("/home", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({params:{taskID},token, method:"claimTask"})
      });

      const text = await res.text();
      try {
        response = JSON.parse(text);
      } catch (jsonErr) {
        throw new Error("Server returned invalid JSON.");
      }

      Swal.close();

      if (response.flag) {
        btn.setAttribute("disabled", "true");
        successAlert(response.errors);
      } else {
        failedAlert(response.errors);
      }

    } catch (err) {
      alert(`Something went wrong! - ${err.message || err}`);
    }

      })
  })
</script>