<!DOCTYPE html>
<html>
<head><title>Loading...</title></head>
<body>
  <p>Checking session...</p>
  <script>
    const token = localStorage.getItem('token');
    if (!token) {
      window.location = '/auth/login';
    } else {
        alert(token)
      // שלח לשרת את הטוקן
      fetch('/auth/session-verify', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ token })
      }).then(res => {
        console.log("here 20")
        console.log(res);
        
        if (res.ok) {
          window.location = '/'; // או /dashboard או מה שצריך
        } else {
          localStorage.removeItem('token');
          window.location = '/auth/login';
        }
      });
    }
  </script>
</body>
</html>
