<h2>{{title}}</h2>

<div class="table-responsive">
<table class="table table-dark table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Date</th>
        <th>Method</th>
        <th>Unique Users</th>
        <th>Usernames</th>
      </tr>
    </thead>
    <tbody>
      {{#each stats}}
        {{#each this}}
          <tr>
            <td>{{@../key}}</td>   <!-- התאריך -->
            <td>{{@key}}</td>      <!-- המתודה -->
            <td>{{this.uniqueUsers}}</td>
            <td>
              {{#each this.users}}
                {{this}}<br>
              {{/each}}
            </td>
          </tr>
        {{/each}}
      {{/each}}
    </tbody>
  </table>
</div>
