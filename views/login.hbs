<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Test Pi Auth</title>
</head>
<body>
  <h1>Pi Login Test</h1>
  <button onclick="startLogin()">🔐 Login with Pi</button>

  <pre id="log"></pre>

  <script src="https://sdk.minepi.com/pi-sdk.js"></script>
  <script>
    Pi.init({ version: "2.0", sandbox: true });

    const log = msg => {
      console.log(msg);
      document.getElementById("log").textContent += (typeof msg === 'string' ? msg : JSON.stringify(msg, null, 2)) + '\n';
    };

    function startLogin() {
      log("➡ Calling Pi.authenticate...");
      Pi.authenticate(["username"], function (result) {
        log("✅ Callback triggered:");
        log(result);

        if (!result || !result.accessToken) {
          log("❌ No access token received.");
          alert("Login failed or cancelled.");
          return;
        }

        alert("Login successful! Username: " + result.user?.username);
      });
    }
  </script>
</body>
</html>
