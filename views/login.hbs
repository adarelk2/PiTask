<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Login | TaskPi (Sandbox Workaround)</title>
  <style>
    body {
      font-family: sans-serif;
      background: #f9f9f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    h1 {
      color: #6b2b8f;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      border: none;
      background: #6b2b8f;
      color: white;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 10px;
    }
    pre {
      margin-top: 20px;
      background: #eee;
      padding: 10px;
      border-radius: 5px;
      width: 90%;
      max-width: 600px;
      overflow: auto;
      text-align: left;
    }
  </style>
</head>
<body>

  <h1>🔐 Login with Pi Network</h1>
  <button onclick="startPiAuth()">Connect with Pi</button>
  <pre id="log"></pre>

  <script src="https://sdk.minepi.com/pi-sdk.js" defer></script>
  <script defer>
    let authResult = null;

    const logEl = document.getElementById('log');
    const log = (msg) => {
      const formatted = typeof msg === 'string' ? msg : JSON.stringify(msg, null, 2);
      console.log('[TaskPi]', formatted);
      logEl.textContent += formatted + '\n';
    };

    document.addEventListener("DOMContentLoaded", function () {
      try {
        Pi.init({ version: "2.0", sandbox: true });
        log("✅ Pi SDK initialized (sandbox)");
      } catch (err) {
        log("❌ Pi.init failed: " + err.message);
      }

      // מאזין להודעות מה־iframe של Pi SDK
      window.addEventListener("message", function (event) {
        if (event.origin !== "https://sandbox.minepi.com") return;

        const payload = event.data?.payload;
        if (!payload?.accessToken) return;

        log("📦 Intercepted Pi auth payload:");
        log(payload);

        // נבנה אובייקט התחברות מדומה
        authResult = {
          accessToken: payload.accessToken,
          user: { username: "sandbox_user" }, // זמני – כי ה-iframe לא שולח username
          signature: payload.signature || "sandbox-signature"
        };

        sendToServer();
      });
    });

    function startPiAuth() {
      log("➡ Calling Pi.authenticate...");
      try {
        Pi.authenticate(["username"], function () {
          log("⏳ Waiting for Pi iframe message...");
          // אנחנו לא סומכים על callback, אלא על postMessage
        });
      } catch (err) {
        log("❌ Pi.authenticate error:");
        log(err.message);
      }
    }

    async function sendToServer() {
      if (!authResult?.accessToken) {
        alert("No accessToken available.");
        return;
      }

      try {
        const res = await fetch('/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(authResult)
        });

        const data = await res.json().catch(() => null);
        log("📨 Server response:");
        log(data || 'No JSON');

        if (data?.success || res.redirected) {
          window.location.href = '/';
        } else {
          alert("Login failed.");
        }

      } catch (err) {
        log("❌ Server error:");
        log(err.message);
        alert("Server error: " + err.message);
      }
    }
  </script>
</body>
</html>
