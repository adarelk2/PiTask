<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>TaskPi Login</title>
  <style>
    body {
      font-family: sans-serif;
      background: #f9f9f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    h1 {
      color: #6b2b8f;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      background: #6b2b8f;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 10px;
    }
    pre {
      margin-top: 20px;
      background: #eee;
      padding: 10px;
      border-radius: 6px;
      width: 90%;
      max-width: 600px;
      overflow: auto;
    }
  </style>
</head>
<body>

  <h1>🔐 Login with Pi Network</h1>
  <button onclick="startPiLogin()">Connect</button>
  <pre id="log"></pre>

  <script src="https://sdk.minepi.com/pi-sdk.js"></script>
  <script>
    let authResult = null;

    const logEl = document.getElementById('log');
    const log = (msg) => {
      const out = typeof msg === 'string' ? msg : JSON.stringify(msg, null, 2);
      logEl.textContent += out + '\n';
      console.log('[TaskPi]', msg);
    };
    console.log("test")
    Pi.init({ version: "2.0", sandbox: true });
    log("✅ Pi SDK initialized");

window.addEventListener("message", function (event) {
  log("📩 Received message from: " + event.origin);

  let data = event.data;

  // ✅ בדיקה: האם צריך לפרסר JSON?
  if (typeof data === 'string') {
    try {
      data = JSON.parse(data);
      log("🧪 Parsed JSON from string:");
    } catch (e) {
      log("❌ Failed to parse message data as JSON:", data);
      return;
    }
  }

  log("🧪 Parsed event data:");
  log(data);

  const { id, payload } = data;

  if (id === 2 && payload?.accessToken) {
    log("🎯 Access token found in message ID 2:");
    log(payload);

    authResult = {
      accessToken: payload.accessToken,
      user: { username: "sandbox_user" },
      signature: payload.signature || "sandbox-signature"
    };

    sendToServer();
  } else {
    log(`⚠️ Message ID ${id} ignored or missing accessToken`);
  }
});


    function startPiLogin() {
      log("➡ Calling Pi.authenticate...");

      Pi.authenticate(["username"], () => {
        log("⏳ Waiting for token from Pi iframe...");
      });
    }

    async function sendToServer() {
      if (!authResult || !authResult.accessToken) {
        log("❌ No access token to send.");
        return;
      }

      log("🚀 Sending POST /auth/login...");

      try {
        const res = await fetch('/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(authResult)
        });

        const data = await res.json().catch(() => null);
        log("📨 Server response:");
        log(data || 'No JSON');

        if (data?.success || res.redirected) {
          window.location.href = '/';
        } else {
          alert('Login failed');
        }
      } catch (err) {
        log("❌ Error sending to server: " + err.message);
        alert("Server error: " + err.message);
      }
    }
  </script>
</body>
</html>
