<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
</head>
<body>

  <h1>🔐 Login with Pi Network</h1>

  <button onclick="startPiLogin()">Connect</button>
  <button onclick="disconnectPi()">Disconnect</button>
  <pre id="log"></pre>

  <script src="https://sdk.minepi.com/pi-sdk.js"></script>
  <script>
    const logEl = document.getElementById('log');
    const log = msg => {
      const formatted = typeof msg === 'string' ? msg : JSON.stringify(msg, null, 2);
      console.log('[TaskPi]', formatted);
      logEl.textContent += formatted + '\n';
    };

    if (typeof Pi === 'undefined') {
      log("❌ Pi SDK not loaded");
    } else {
      Pi.init({ version: "2.0" }); // Production only
      log("✅ Pi SDK initialized (production)");
    }

    function startPiLogin() {
      if (typeof Pi === 'undefined') {
        alert("Pi SDK not loaded. Make sure you're in the Pi Browser.");
        return;
      }

      log("➡ Calling Pi.authenticate...");

      try {
        Pi.authenticate(["username", "payments"], async function (auth) {
          if (!auth?.accessToken || !auth?.signature) {
            log("❌ Missing Pi auth result");
            return alert("Login failed.");
          }

          log("🔐 Got Pi auth:");
          log(auth);

          const res = await fetch('/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              accessToken: auth.accessToken,
              signature: auth.signature
            })
          });

          const data = await res.json().catch(() => null);
          log("📨 Server response:");
          log(data || 'No JSON');

          if (data?.success || res.redirected) {
            window.location.href = '/';
          } else {
            alert("Login failed.");
          }

        });
      } catch (e) {
        log("❌ Pi.authenticate error:");
        log(e.message);
        alert("Something went wrong with Pi SDK");
      }
    }

    function disconnectPi() {
      log("🔄 Clearing session data and reloading...");
      sessionStorage.clear();
      localStorage.clear();
      location.reload();
    }
  </script>
</body>
</html>
