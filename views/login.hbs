<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Login | TaskPi</title>
  <style>
    body {
      font-family: sans-serif;
      background: #f9f9f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    h1 {
      color: #6b2b8f;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      border: none;
      background: #6b2b8f;
      color: white;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 20px;
    }
    pre {
      margin-top: 30px;
      background: #eee;
      padding: 10px;
      border-radius: 5px;
      width: 90%;
      max-width: 600px;
      overflow: auto;
    }
  </style>
</head>
<body>

  <h1>🔐 Connect to Pi Network</h1>
  <button onclick="authenticate()">Connect Wallet</button>
  <pre id="output"></pre>

  <script src="https://sdk.minepi.com/pi-sdk.js"></script>
  <script>
    const output = document.getElementById('output');
    const log = msg => {
      const formatted = typeof msg === 'string' ? msg : JSON.stringify(msg, null, 2);
      output.textContent += formatted + '\n';
    };

    Pi.init({ version: "2.0", sandbox: true });

    async function authenticate() {
      try {
        Pi.authenticate(["username"], async function (authResult) {
          const { user, accessToken, signature } = authResult;

          log("🔐 Authenticated user:");
          log(authResult);

          const res = await fetch('/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              user,
              accessToken,
              signature
            })
          });

          const data = await res.json().catch(() => null);
          log(data || 'No JSON response');

          if (data?.success || res.redirected) {
            window.location.href = '/';
          } else {
            alert('Sandbox login failed');
          }
        });
      } catch (err) {
        log(err.message || err);
        alert("Something went wrong: " + err.message);
      }
    }
  </script>
</body>
</html>
