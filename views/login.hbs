<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Login | TaskPi</title>
  <style>
    body {
      font-family: sans-serif;
      background: #f9f9f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    h1 {
      color: #6b2b8f;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      border: none;
      background: #6b2b8f;
      color: white;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 10px;
    }
    pre {
      margin-top: 20px;
      background: #eee;
      padding: 10px;
      border-radius: 5px;
      width: 90%;
      max-width: 600px;
      overflow: auto;
    }
  </style>
</head>
<body>

  <h1>🔐 Connect to Pi Network</h1>

  <button onclick="authenticate()">Step 1: Pi Authenticate</button>
  <button onclick="sendToServer()">Step 2: Send to Server</button>

  <pre id="output"></pre>

  <script src="https://sdk.minepi.com/pi-sdk.js"></script>
<script>
  const output = document.getElementById('output');
  const log = msg => {
    const formatted = typeof msg === 'string' ? msg : JSON.stringify(msg, null, 2);
    output.textContent += formatted + '\n';
  };

  let authResult = null;

  Pi.init({ version: "2.0", sandbox: true });

  async function authenticate() {
    try {
      Pi.authenticate(["username"], function (result) {
        if (!result || !result.accessToken) {
          log("❌ Authentication failed or cancelled.");
          alert("User did not complete Pi login.");
          return;
        }

        authResult = result;
        log("✅ Authentication success:");
        log(result);

        // הפעל אוטומטית את שליחת הנתונים לשרת לאחר התחברות מוצלחת
        sendToServer(); // אפשר גם להשאיר את זה לחצן נפרד
      });
    } catch (err) {
      log("❌ Pi SDK error:");
      log(err.message || err);
      alert("Error: " + err.message);
    }
  }

  async function sendToServer() {
    if (!authResult || !authResult.accessToken || !authResult.user?.username) {
      alert("You must authenticate with Pi first.");
      return;
    }

    try {
      const res = await fetch('/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(authResult)
      });

      const data = await res.json().catch(() => null);
      log("📨 Server response:");
      log(data || 'No JSON response');

      if (data?.success || res.redirected) {
        window.location.href = '/';
      } else {
        alert('Login failed');
      }

    } catch (err) {
      log("❌ Server error:");
      log(err.message || err);
      alert("Server error: " + err.message);
    }
  }
</script>

</body>
</html>
