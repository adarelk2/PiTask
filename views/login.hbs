<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-strong border-0 fade-in">
          <div class="card-body p-5 text-center">
            <!-- Logo Section -->
            <div class="mb-4">
              <div class="bg-primary bg-opacity-10 rounded-circle p-4 mx-auto mb-3" style="width: 100px; height: 100px;">
                <img src="/logo.PNG" alt="Pi Logo" class="img-fluid" style="max-width: 60px;">
              </div>
            </div>

            <!-- Title Section -->
            <h2 class="mb-3 text-primary fw-bold">{{__ "sign_in_title"}}</h2>
            <p class="text-muted mb-4">{{__ "sign_in_subtitle"}}</p>

            <!-- Login Button -->
            <button id="login-btn" class="btn btn-warning btn-lg w-100 mb-4">
              <i class="fas fa-sign-in-alt me-2"></i>
              {{__ "login_with_pi"}}
            </button>

            <!-- Status Alert -->
            <div id="auth-status" class="alert d-none mt-4" role="alert"></div>

            <!-- Additional Info -->
            <div class="mt-4 pt-4 border-top">
              <p class="text-muted small mb-0">
                <i class="fas fa-info-circle me-1"></i>
                Make sure you're using the Pi Browser for the best experience
              </p>
            </div>
          </div>
        </div>

        <!-- Features Section -->
        <div class="row mt-4">
          <div class="col-12">
            <div class="card shadow-soft border-0">
              <div class="card-body p-4">
                <h5 class="text-center mb-4 text-primary">
                  <i class="fas fa-star me-2"></i>Why Choose TaskPi?
                </h5>
                <div class="row text-center">
                  <div class="col-4">
                    <div class="mb-3">
                      <i class="fas fa-tasks text-primary fs-4 mb-2"></i>
                      <p class="small text-muted mb-0">Easy Tasks</p>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="mb-3">
                      <i class="fas fa-coins text-warning fs-4 mb-2"></i>
                      <p class="small text-muted mb-0">Pi Rewards</p>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="mb-3">
                      <i class="fas fa-shield-alt text-success fs-4 mb-2"></i>
                      <p class="small text-muted mb-0">Secure</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Pi SDK -->
<script src="https://sdk.minepi.com/pi-sdk.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const statusBox = document.getElementById("auth-status");

  function showMessage(type, text) {
    statusBox.className = "alert mt-4 alert-" + type;
    statusBox.textContent = text;
    statusBox.classList.remove("d-none");
  }

  if (!window.Pi) {
    showMessage("danger", "Pi SDK not available. Please open this app inside Pi Browser.");
    return;
  }

  window.Pi.init({ version: "2.0" });

  document.getElementById("login-btn").addEventListener("click", async () => {
    try {
      showMessage("info", "🔄 Connecting to Pi Network...");

      const auth = await window.Pi.authenticate(["username", "wallet_address", "payments"]);
      console.log("✅ Authenticated:", auth);
      showMessage("success", `✅ Authenticated as @${auth.user.username}`);
      
      const res = await fetch("/auth/verify-token", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ piToken: auth.accessToken })
      });

      const result = await res.json();
      let lang='en'
      if(localStorage.getItem('lang'))
      {
        lang = localStorage.getItem('lang')
      }
      if (result.success) {
        localStorage.setItem("token", result.token);
        showMessage("success", "✅ Login successful! Redirecting...");
        setTimeout(() => {
          window.location.href = `/?token=${result.token}&lang=${lang}`;
        }, 1500);
      } else {
        showMessage("danger", "❌ Authentication failed on server.");
      }

    } catch (err) {
      console.error("❌ Pi login error:", err);
      showMessage("danger", "Login failed: " + (err.message || "unknown error"));
    }
  });
});
</script>
